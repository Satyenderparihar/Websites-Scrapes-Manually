{
  "manifest_version": 3,
  "name": "Smart Page Styler & Word Counter",
  "version": "1.0.0",
  "description": "पेज के शब्दों को गिनने और बैकग्राउंड स्टाइल बदलने का कस्टम एक्सटेंशन",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
