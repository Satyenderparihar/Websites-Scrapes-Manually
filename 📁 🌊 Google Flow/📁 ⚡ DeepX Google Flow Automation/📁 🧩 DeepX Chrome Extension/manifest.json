{
  "manifest_version": 3,
  "name": "DeepX - Antigravity Flow Bridge",
  "short_name": "DeepX Flow",
  "version": "1.2.1",
  "description": "Unified high-performance zero-latency bridge connecting Antigravity Coding Agents directly to Google Flow (Veo Omni, Veo 3.1 & Imagen 3) with rapid parallel dispatch, multi-ingredient stacking, ultra-fast DataTransfer uploads, and mobile Kiwi Browser zero-crash engine.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DeepX Flow Studio",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google.com/*",
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": ["catchUploadFile.js", "content-script-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google.com/*",
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": ["content-script-isolated.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["youtube-detector.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "scripting",
    "sidePanel",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://labs.google.com/*",
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "resources": [
        "catchUploadFile.js",
        "content-script-main.js",
        "icons/dipeshkyd_logo.jpg"
      ]
    }
  ]
}
